# JWT Secret for Admin Session Token Signing
JWT_SECRET="kunal-portfolio-secure-jwt-key-2026"

# Cloudinary Image Pipelines (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
